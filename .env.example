# Required: obtain your own token from @BotFather. Never commit .env.
BOT_TOKEN=
DATABASE_PATH=data/orders.sqlite3

# Deployment identity: keep real values only in your local .env.
SHOP_NAME=Магазин
# Optional username with or without @; no URL. Empty hides support contacts.
SUPPORT_TELEGRAM_USERNAME=
DELIVERY_TERMS=Условия и сроки доставки уточнит менеджер.
# Optional replacement of the default consent message (plain text).
CONSENT_TEXT=
TIME_ZONE=UTC

# Optional notifications: private manager chat or closed group.
ADMIN_CHAT_ID=
ADMIN_MESSAGE_THREAD_ID=
# Telegram USER IDs allowed to use /bindorder, comma-separated.
# Empty = /bindorder disabled, even in the manager group.
ADMIN_USER_IDS=

# Optional Google Sheets integration: fill all three to enable.
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_JSON=
# Alternative to JSON credentials:
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=

# Optional Google Tasks integration: fill both to enable.
GOOGLE_TASKS_CREDENTIALS_FILE=
GOOGLE_TASKS_LIST_ID=
